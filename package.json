{
  "name": "youtube-focus-filter",
  "version": "0.1.0",
  "private": true,
  "description": "Firefox extension that blocks YouTube thumbnails unrelated to what you want to focus on, using an on-device MiniLM embedding model.",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "calibrate": "node scripts/calibrate.mjs",
    "start": "web-ext run --source-dir extension --start-url https://www.youtube.com",
    "lint": "web-ext lint --source-dir extension",
    "build": "web-ext build --source-dir extension --artifacts-dir dist --overwrite-dest"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.0",
    "web-ext": "^8.0.0"
  }
}
